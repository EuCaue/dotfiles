[Unit]
Description=Weekly Backup

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
Environment=ZK_NOTEBOOK_DIR=%h/Documents/zk
ExecStart=%h/dotfiles/scripts/weekly-backup.sh
ExecStartPost=%h/Documents/zk/scripts/zk-review-reminder.sh
