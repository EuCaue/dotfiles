{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "adwaita",
    "mode": "system"
  },
  "keybinds": {
    "variant.list": "<leader>v"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept",
    "verbosity": "medium"
  },
  "animations": true,
  "tabs": {
    "indicators": "status"
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": true
  }
}
