{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "update": "auto",
  "shell": "zsh",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "lsp": true,
  "formatter": true,
  "permissions": [
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "default_agent": "build",
  "agents": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "system": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "second-opinion": {
      "description": "Second code review. Use only when cavecrew-reviewer reports a 🔴 bug or the diff touches more than 5 files.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "git diff*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git log*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "git show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*--output*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "* -O*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*--open-files-in-pager*",
          "effect": "deny"
        }
      ]
    },
    "vision": {
      "description": "Describes images and screenshots. Never send it code.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
