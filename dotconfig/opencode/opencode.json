{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail", "opencode-discord-presence"],
  "autoupdate": true,
  "shell": "zsh",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "lsp": true,
  "formatter": true,
  "permission": {
    "todowrite": "allow",
    "question": "allow"
  },
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false
      },
      "options": {},
      "permission": {
        "edit": "deny"
      }
    }
  }
}
